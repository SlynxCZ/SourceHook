# Buildable two ways:
#  - Standalone (configure.py + ambuild): builds vendor/safetyhook and
#    vendor/zydis into libsourcehook itself.
#  - As a sub-build from another project's own AMBuildScript, the same way
#    metamod-source pulls in versionlib/AMBuildScript or KHook pulls in
#    safetyhook's AMBuildScript:
#
#      SourceHookLib = builder.Build('vendor/sourcehook/AMBuildScript', {
#        'SourceHookBundleVendor': False,  # omit if the caller has no
#                                           # vendor/{safetyhook,zydis} of
#                                           # its own to collide with
#      })
#      ...
#      binary.compiler.linkflags += [SourceHookLib['binaries_by_arch'][cxx.target.arch]]
#      SourceHookLib['config'].AddPublicIncludes(binary)
#
#    AddPublicIncludes() is the point: it adds every include path a consumer
#    of "sourcehook/sourcehook.h" needs (include/ + vendor/{safetyhook,tl,
#    zydis}) in one call, computed from *this* repo's own builder.sourcePath
#    -- so a caller never has to hand-list sourcehook's internal folder
#    layout itself (and re-break every time that layout changes, like it
#    just did going from src/{core,hookmangen,inline,util} to
#    include/sourcehook/ + src/hookmangen).
#
#    SourceHookBundleVendor=False skips compiling vendor/safetyhook and
#    vendor/zydis into libsourcehook (their headers are still added to the
#    include path either way -- sourcehook's own sources need them to
#    compile) so a caller that already builds its own copies of those two
#    (e.g. because it also uses safetyhook directly, like
#    InventoryManager_mm_es) doesn't get duplicate-symbol link errors from
#    two static libraries both containing the same object code.
import os, sys

SourceHookBundleVendor = globals().get('SourceHookBundleVendor', True)

class SourceHookConfig(object):
  def __init__(self):
    self.all_targets = []
    self.binaries = []
    self.binaries_by_arch = {}

    if builder.options.targets:
      target_archs = builder.options.targets.split(',')
    else:
      target_archs = ['x86_64']

    for arch in target_archs:
      try:
        cxx = builder.DetectCxx(target_arch=arch)
      except Exception as e:
        if builder.options.targets:
          raise
        print('Skipping target {}: {}'.format(arch, e))
        continue
      self.all_targets.append(cxx)

    if not self.all_targets:
      raise Exception('No suitable C/C++ compiler was found.')

  def configure(self):
    for cxx in self.all_targets:
      self.configure_cxx(cxx)

  def configure_cxx(self, cxx):
    if cxx.behavior == 'gcc':
      cxx.cflags += [
        '-pipe',
        '-fno-strict-aliasing',
        '-Wall',
        '-Wno-uninitialized',
        '-Wno-unused',
        '-Wno-switch',
        '-Wno-invalid-offsetof',
        '-msse',
        '-fPIC',
      ]
      cxx.cxxflags += [
        '-std=c++20',
        '-frtti',
        '-fno-threadsafe-statics',
        '-fvisibility=hidden',
        '-fvisibility-inlines-hidden',
        '-Wno-non-virtual-dtor',
        '-Wno-overloaded-virtual',
      ]
      if cxx.family == 'gcc':
        cxx.cflags += ['-mfpmath=sse']
      if cxx.family == 'clang':
        cxx.cxxflags += ['-Wno-implicit-exception-spec-mismatch']

    elif cxx.like('msvc'):
      if builder.options.debug == '1':
        cxx.cflags += ['/MTd']
        cxx.linkflags += ['/NODEFAULTLIB:libcmt']
      else:
        cxx.cflags += ['/MT']
      cxx.defines += [
        '_CRT_SECURE_NO_DEPRECATE',
        '_CRT_SECURE_NO_WARNINGS',
        '_CRT_NONSTDC_NO_DEPRECATE',
      ]
      cxx.cflags += [
        '/W3',
        '/Zi',
        '/EHsc',
        '/std:c++20',
      ]
      cxx.cxxflags += ['/TP']

    # Optimization
    if builder.options.opt == '1':
      cxx.defines += ['NDEBUG']
      if cxx.behavior == 'gcc':
        cxx.cflags += ['-O3']
      elif cxx.behavior == 'msvc':
        cxx.cflags += ['/Ox', '/Zo']
        cxx.linkflags += ['/OPT:ICF', '/OPT:REF']

    # Debugging
    if builder.options.debug == '1':
      cxx.defines += ['DEBUG', '_DEBUG']
      if cxx.behavior == 'gcc':
        cxx.cflags += ['-g3']
      elif cxx.behavior == 'msvc':
        cxx.cflags += ['/Od', '/RTC1']

    if cxx.behavior == 'gcc':
      cxx.cflags += ['-fno-omit-frame-pointer']
    elif cxx.behavior == 'msvc':
      cxx.cflags += ['/Oy-']

    # Platform-specifics
    if cxx.target.platform == 'linux':
      cxx.defines += ['_LINUX', 'LINUX', 'POSIX', '_FILE_OFFSET_BITS=64']
    elif cxx.target.platform == 'windows':
      cxx.defines += ['WIN32', '_WINDOWS']

  def AddPublicIncludes(self, binary):
    # include/ is the ONE directory a consumer needs: sourcehook.h (which
    # pulls in sourcehook_inline.h itself, see its file header) and
    # everything it transitively needs (sourcehook_impl*.h, sh_*.h,
    # FastDelegate.h) live namespaced under include/sourcehook/, so a
    # consumer writes #include "sourcehook/sourcehook.h". vendor/
    # {safetyhook,tl,zydis} are needed too since sourcehook_inline.h needs
    # safetyhook.hpp. Call this on any binary that #includes
    # "sourcehook/sourcehook.h" -- this library's own sources and any
    # downstream consumer alike (see this file's own header comment for the
    # SourceHookLib['config'].AddPublicIncludes(binary) sub-build usage).
    binary.compiler.cxxincludes += [
      os.path.join(builder.sourcePath, 'include'),
      os.path.join(builder.sourcePath, 'vendor'),
      os.path.join(builder.sourcePath, 'vendor', 'safetyhook'),
      os.path.join(builder.sourcePath, 'vendor', 'tl'),
      os.path.join(builder.sourcePath, 'vendor', 'zydis'),
    ]
    # Zydis.c uses angle-bracket #include <Zydis.h>, which only the plain
    # (non-cxx) include path list satisfies for the C compilation unit.
    binary.compiler.includes += [
      os.path.join(builder.sourcePath, 'vendor', 'zydis'),
    ]
    binary.compiler.defines += ['ZYDIS_STATIC_BUILD']

  def AddHookmanGenIncludes(self, binary):
    # src/hookmangen holds the vtable-hook JIT codegen internals
    # (sourcehook_hookmangen*, sh_asm*.h, sourcehook_pibuilder.h) -- private
    # to this library's own build. Only needed by binaries that compile (or,
    # like the legacy test suite, directly #include) those internals -- a
    # normal downstream consumer never needs this, only AddPublicIncludes.
    binary.compiler.cxxincludes += [
      os.path.join(builder.sourcePath, 'src', 'hookmangen'),
    ]

  def AddVendorSources(self, binary):
    binary.sources += [
      os.path.join(builder.sourcePath, 'vendor', 'safetyhook', 'safetyhook.cpp'),
      os.path.join(builder.sourcePath, 'vendor', 'zydis', 'Zydis.c'),
    ]

  def Library(self, cxx, name):
    binary = cxx.StaticLibrary(name)
    return binary

  def build(self):
    for cxx in self.all_targets:
      lib = self.Library(cxx, 'sourcehook')

      lib.sources += [
        os.path.join('src', 'core', 'sourcehook.cpp'),
        os.path.join('src', 'core', 'sourcehook_impl_chookidman.cpp'),
        os.path.join('src', 'core', 'sourcehook_impl_chookmaninfo.cpp'),
        os.path.join('src', 'core', 'sourcehook_impl_cproto.cpp'),
        os.path.join('src', 'core', 'sourcehook_impl_cvfnptr.cpp'),
        os.path.join('src', 'hookmangen', 'sourcehook_hookmangen.cpp'),
        os.path.join('src', 'inline', 'sourcehook_impl_inline.cpp'),
      ]

      if cxx.target.arch == 'x86':
        lib.sources += [os.path.join('src', 'hookmangen', 'sourcehook_hookmangen_x86.cpp')]
      elif cxx.target.arch == 'x86_64' and cxx.target.platform != 'linux':
        # Matches metamod-source's own core/AMBuilder: the x86_64 vtable
        # hookmangen's GCC/Linux register-marshaling paths are
        # static_assert(false, ...) stubs and it uses `xor` as an
        # identifier (a reserved alternative token under GCC/Clang), so it
        # isn't built on Linux x86_64 upstream either. Inline hooks
        # (sourcehook_inline.h) don't depend on this file.
        lib.sources += [os.path.join('src', 'hookmangen', 'sourcehook_hookmangen_x86_64.cpp')]

      # Headers are always needed to compile sourcehook's own sources
      # (safetyhook.hpp, Zydis.h, tl/expected.hpp); the vendor .c/.cpp
      # themselves are opt-out, see the file header comment above.
      self.AddPublicIncludes(lib)
      self.AddHookmanGenIncludes(lib)
      if SourceHookBundleVendor:
        self.AddVendorSources(lib)

      node = builder.Add(lib)
      self.binaries += [node]
      self.binaries_by_arch[cxx.target.arch] = node.binary

SHook = SourceHookConfig()
SHook.configure()
SHook.build()

BuildScripts = []
if getattr(builder.options, 'enable_tests', False):
  BuildScripts += ['test/AMBuilder']

if BuildScripts:
  builder.Build(BuildScripts, { 'SHook': SHook })

# What a parent build (builder.Build('vendor/sourcehook/AMBuildScript', {...}))
# gets back: the compiled-library paths (same {arch: path} convention as
# metamod-source's own versionlib/AMBuildScript), plus the config object
# itself so the caller can call SourceHookLib['config'].AddPublicIncludes(binary)
# instead of re-declaring sourcehook's internal folder layout by hand.
rvalue = {
  'binaries_by_arch': SHook.binaries_by_arch,
  'config': SHook,
}
